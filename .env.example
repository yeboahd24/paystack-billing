# Email (optional — noop sender when unset)
BREVO_API_KEY=
BREVO_FROM_EMAIL=billing@example.com
BREVO_FROM_NAME=Payment Billing

# Paystack (optional — checkout fails when unset)
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=GHS

# Redis (required for rate limiting)
REDIS_URL=redis://localhost:6379/0

# SQLite
SQLITE_PATH=./data/billing.db
